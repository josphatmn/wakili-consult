generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum PlanType {
  FREE
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum AgentType {
  RESEARCH
  DRAFTING
  CONTRACT_REVIEW
  CASE_LAW
  LITIGATION
  FAMILY_LAW
  EMPLOYMENT_LAW
  LAND_LAW
  IMMIGRATION
  CORPORATE
  TAX
  COMPLIANCE
  CRIMINAL_LAW
  SUCCESSION
  CONSTITUTION
  BUSINESS_REGISTRATION
}

enum DocumentType {
  PDF
  DOCX
  TXT
  IMAGE
  OTHER
}

model User {
  id             String             @id @default(cuid())
  name           String?
  email          String             @unique
  emailVerified  Boolean            @default(false)
  image          String?
  role           UserRole           @default(USER)
  credits        Int                @default(10)
  phone          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  accounts       Account[]
  sessions       Session[]
  subscription   Subscription?
  payments       Payment[]
  invoices       Invoice[]
  researches     Research[]
  conversations Conversation[]
  documents      Document[]
  notifications  Notification[]
  organizations  OrganizationMember[]
  apiKeys        APIKey[]
  clients        Client[]
  contractReviews ContractReview[]

  @@index([email])
  @@index([role])
}

model Session {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  token      String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ipAddress  String?
  userAgent  String?

  @@index([userId])
  @@index([token])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              PlanType           @default(FREE)
  status            SubscriptionStatus @default(TRIAL)
  startsAt          DateTime           @default(now())
  endsAt            DateTime?
  trialEndsAt       DateTime?
  canceledAt        DateTime?
  paystackSubId     String?
  paystackPlanId    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([plan])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  currency        String   @default("KES")
  status          String
  reference       String   @unique
  paystackRef     String?
  channel         String?
  paidAt          DateTime?
  invoices        Invoice[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([reference])
  @@index([status])
}

model Invoice {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  currency        String   @default("KES")
  status          String
  invoiceCode     String   @unique
  paidAt          DateTime?
  paymentId       String?
  payment         Payment? @relation(fields: [paymentId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([invoiceCode])
}

model Research {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query       String
  summary     String?
  analysis    String?
  sources     String?
  confidence  Float?
  citations   Citation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model Conversation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  agentType   AgentType @default(RESEARCH)
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  citations      String?
  metadata       String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model Citation {
  id          String   @id @default(cuid())
  researchId  String
  research    Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  title       String
  source      String
  section     String?
  relevance   Float?
  url         String?
  text        String?
  createdAt   DateTime @default(now())

  @@index([researchId])
}

model Document {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  type             DocumentType
  fileUrl          String
  fileSize         Int?
  content          String?         @db.LongText
  summary          String?         @db.Text
  metadata         String?         @db.Text
  contractReviewId String?
  contractReview   ContractReview? @relation(fields: [contractReviewId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([type])
  @@index([contractReviewId])
}

model ContractReview {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  status          String     @default("IN_PROGRESS")
  risks           String?    @db.Text
  missingClauses  String?    @db.Text
  recommendations String?    @db.Text
  summary         String?    @db.Text
  documents       Document[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
  @@index([status])
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  summary     String?
  category    String
  tags        String?
  sources     String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([published])
}

model LegalAct {
  id          String   @id @default(cuid())
  title       String
  actNumber   String?
  year        Int?
  category    String
  content     String?
  summary     String?
  sections    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
  @@index([category])
}

model CaseLaw {
  id          String   @id @default(cuid())
  title       String
  caseNumber  String?
  court       String
  judge       String?
  year        Int?
  parties     String?
  summary     String?
  ruling      String?
  citations   String?
  relevanceScore Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
  @@index([court])
  @@index([year])
}

model AIAgent {
  id          String    @id @default(cuid())
  type        AgentType @unique
  name        String
  description String?
  systemPrompt String?
  model       String    @default("gpt-5.5")
  temperature Float     @default(0.7)
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  agentType   AgentType
  content     String
  variables   String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([agentType])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  type      String?
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  resourceId String?
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Organization {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  logo        String?
  members     OrganizationMember[]
  invitations Invitation[]
  apiKeys     APIKey[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  role           String       @default("MEMBER")
  token          String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([email])
  @@index([token])
}

model APIKey {
  id             String       @id @default(cuid())
  name           String
  key            String       @unique
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([key])
  @@index([userId])
}

enum ClientType {
  INDIVIDUAL
  CORPORATE
}

enum CaseStatus {
  ACTIVE
  PENDING
  CLOSED
  ARCHIVED
  ON_HOLD
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TimelineType {
  FILING
  HEARING
  MEETING
  NOTE
  DOCUMENT
  TASK
  MILESTONE
}

model Client {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  idNumber  String?
  kraPin    String?
  address   String?
  type      ClientType @default(INDIVIDUAL)
  notes     String?    @db.Text
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cases     CaseSpace[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([name])
  @@index([email])
}

model CaseSpace {
  id          String     @id @default(cuid())
  caseNumber  String?
  title       String
  description String?    @db.Text
  status      CaseStatus @default(ACTIVE)
  caseType    String?
  court       String?
  judge       String?
  filedDate   DateTime?
  priority    Priority   @default(MEDIUM)
  opponents   String?    @db.Text
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo  String?
  documents   CaseDocument[]
  tasks       Task[]
  timeline    TimelineEntry[]
  hearings    Hearing[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([caseNumber])
}

model CaseDocument {
  id          String     @id @default(cuid())
  caseSpaceId String
  caseSpace   CaseSpace  @relation(fields: [caseSpaceId], references: [id], onDelete: Cascade)
  title       String
  type        DocumentType @default(OTHER)
  fileUrl     String
  fileSize    Int?
  description String?    @db.Text
  uploadedBy  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([caseSpaceId])
  @@index([uploadedBy])
}

model Task {
  id          String     @id @default(cuid())
  caseSpaceId String
  caseSpace   CaseSpace  @relation(fields: [caseSpaceId], references: [id], onDelete: Cascade)
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  assignedTo  String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([caseSpaceId])
  @@index([status])
  @@index([assignedTo])
}

model TimelineEntry {
  id          String       @id @default(cuid())
  caseSpaceId String
  caseSpace   CaseSpace    @relation(fields: [caseSpaceId], references: [id], onDelete: Cascade)
  title       String
  description String?      @db.Text
  type        TimelineType @default(NOTE)
  date        DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([caseSpaceId])
  @@index([date])
}

model Hearing {
  id          String   @id @default(cuid())
  caseSpaceId String
  caseSpace   CaseSpace @relation(fields: [caseSpaceId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime
  court       String?
  judge       String?
  notes       String?  @db.Text
  outcome     String?  @db.Text
  nextDate    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([caseSpaceId])
  @@index([date])
}
